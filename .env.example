# Pick ONE transport. Both reach the same model with the same questions.
# Server-side only — never prefix anything here with NEXT_PUBLIC_.

# ---- Option A: TypeSafe native API ------------------------------------------
# A key from https://typesafe.ai. No Vercel billing involved.
JEV_TRANSPORT=native
TYPESAFE_API_KEY=

# ---- Option B: Vercel AI Gateway --------------------------------------------
# A key from https://vercel.com/ai-gateway. NOTE (verified 2026-09-20): the free
# tier for typesafe-ai/jev allows roughly one call before every subsequent
# request fails with GatewayRateLimitError, spacing does not help. Paid credits
# are required for actual play. Comment out the two lines above to switch.
# JEV_TRANSPORT=gateway
# AI_GATEWAY_API_KEY=

# ---- Optional ---------------------------------------------------------------
# BOARD_SIZE=15
# JEV_MODEL=typesafe-ai/jev       # gateway model id
# JEV_NATIVE_MODEL=jev-latest     # native model id
